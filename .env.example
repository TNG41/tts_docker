# Copy this file to .env and fill in real values. Never commit .env.

# Required
DISCORD_BOT_TOKEN=

# Optional: your Discord user ID, enables auto-join behavior for you
OWNER_USER_ID=

# Optional: "gtts" (default) or "elevenlabs" for the owner's messages
TTS_ENGINE=gtts

# Only used when TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3